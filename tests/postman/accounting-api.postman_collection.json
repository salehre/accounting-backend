{
    "info": {
        "name": "Accounting API (Laravel)",
        "description": "Auth and permission tests. Select the 'Accounting - Local' environment and start the server first: php artisan serve",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "00 Health",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('ok is true', () => pm.expect(pm.response.json().ok).to.eql(true));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
            }
        },
        {
            "name": "01 Accounts without token (expect 401)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('rejected without a token (401)', () => pm.response.to.have.status(401));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
            }
        },
        {
            "name": "02 Login admin (token)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200', () => pm.response.to.have.status(200));",
                            "if (pm.response.code === 200) {",
                            "  const json = pm.response.json();",
                            "  pm.test('returns a token', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
                            "  pm.test('role is admin', () => pm.expect(json.user.role).to.eql('admin'));",
                            "  pm.environment.set('adminToken', json.token);",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"device_name\": \"postman\"\n}",
                    "options": { "raw": { "language": "json" } }
                },
                "url": { "raw": "{{baseUrl}}/auth/token", "host": ["{{baseUrl}}"], "path": ["auth", "token"] }
            }
        },
        {
            "name": "03 Me (admin)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.test('username matches', () => pm.expect(json.username).to.eql(pm.environment.get('adminUsername').toLowerCase()));",
                            "pm.test('admin has the wildcard permission', () => pm.expect(json.permissions).to.include('*'));"
                        ]
                    }
                }
            ],
            "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
            }
        },
        {
            "name": "04 Accounts (admin)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('returns a list', () => pm.expect(pm.response.json()).to.be.an('array'));"
                        ]
                    }
                }
            ],
            "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
            }
        },
        {
            "name": "05 Login viewer (token)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200', () => pm.response.to.have.status(200));",
                            "if (pm.response.code === 200) {",
                            "  const json = pm.response.json();",
                            "  pm.test('role is viewer', () => pm.expect(json.user.role).to.eql('viewer'));",
                            "  pm.environment.set('viewerToken', json.token);",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"username\": \"{{viewerUsername}}\",\n  \"password\": \"{{viewerPassword}}\",\n  \"device_name\": \"postman\"\n}",
                    "options": { "raw": { "language": "json" } }
                },
                "url": { "raw": "{{baseUrl}}/auth/token", "host": ["{{baseUrl}}"], "path": ["auth", "token"] }
            }
        },
        {
            "name": "06 Me (viewer)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.test('viewer is not a wildcard admin', () => pm.expect(json.permissions).to.not.include('*'));",
                            "pm.test('viewer can read accounts', () => pm.expect(json.permissions).to.include('accounts.read'));"
                        ]
                    }
                }
            ],
            "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{viewerToken}}", "type": "string" }] },
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
            }
        },
        {
            "name": "07 Accounts (viewer)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('viewer may read accounts (200)', () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ],
            "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{viewerToken}}", "type": "string" }] },
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
            }
        },
        {
            "name": "08 Logout (admin)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('status is 200', () => pm.response.to.have.status(200));",
                            "pm.test('ok is true', () => pm.expect(pm.response.json().ok).to.eql(true));"
                        ]
                    }
                }
            ],
            "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
                "method": "POST",
                "header": [],
                "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
            }
        },
        {
            "name": "09 Me after logout (expect 401)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('revoked token is rejected (401)', () => pm.response.to.have.status(401));"
                        ]
                    }
                }
            ],
            "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
            }
        },
        {
            "name": "10 Lockout after 5 wrong passwords (viewer)",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "// Sends 6 wrong-password logins one after another and records the status codes.",
                            "const statuses = [];",
                            "const attempt = (i) => {",
                            "  if (i >= 6) {",
                            "    pm.environment.set('lockoutStatuses', JSON.stringify(statuses));",
                            "    return;",
                            "  }",
                            "  pm.sendRequest({",
                            "    url: pm.variables.replaceIn('{{baseUrl}}/auth/token'),",
                            "    method: 'POST',",
                            "    header: { 'Accept': 'application/json', 'Content-Type': 'application/json' },",
                            "    body: {",
                            "      mode: 'raw',",
                            "      raw: JSON.stringify({",
                            "        username: pm.environment.get('viewerUsername'),",
                            "        password: 'definitely-wrong-password',",
                            "        device_name: 'postman-lockout'",
                            "      })",
                            "    }",
                            "  }, (error, response) => {",
                            "    statuses.push(error ? 0 : response.code);",
                            "    attempt(i + 1);",
                            "  });",
                            "};",
                            "attempt(0);"
                        ]
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const statuses = JSON.parse(pm.environment.get('lockoutStatuses') || '[]');",
                            "pm.test('first 5 attempts get 401', () => pm.expect(statuses.slice(0, 5)).to.eql([401, 401, 401, 401, 401]));",
                            "pm.test('6th attempt is blocked with 429', () => pm.expect(statuses[5]).to.eql(429));"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
            }
        },
        {
            "name": "Manual - run only after the SQL step (see instructions)",
            "item": [
                {
                    "name": "M1 Accounts (viewer without accounts.read) - expect 403",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('forbidden (403)', () => pm.response.to.have.status(403));",
                                    "pm.test('message explains why', () => pm.expect(pm.response.json().message).to.include('permission'));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{viewerToken}}", "type": "string" }] },
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
                    }
                }
            ]
        }
    ]
}
